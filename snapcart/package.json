{
  "name": "snapcart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/user/stripe/webhook --events checkout.session.completed --all-snapshot",
    "dev:all": "concurrently -n NEXT,STRIPE -c green,magenta \"pnpm run dev\" \"pnpm run stripe:listen\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@types/leaflet": "^1.9.22",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "lucide-react": "^1.18.0",
    "mongoose": "^9.6.3",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
